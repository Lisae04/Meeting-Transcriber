# Copy this file to ".env" (same folder) and fill in ONE of the keys below.
# The .env file is only read locally by transcribe_meeting.py -- it is never
# sent anywhere except directly to the provider you choose, as part of the
# normal API call.

# Default provider is Anthropic (Claude). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: only needed if you run with --provider openai
# OPENAI_API_KEY=

# Optional overrides (sensible defaults are used if you leave these out)
# WHISPER_MODEL=small
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_MODEL=gpt-4o
